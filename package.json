{
  "name": "maitake",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "private": true,
  "type": "module",
  "description": "ブラウザ内だけで動画を変換する静的Webアプリ",
  "scripts": {
    "build": "node scripts/vendor.mjs",
    "build:release": "node scripts/vendor.mjs && node scripts/bundle-sources.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15"
  }
}
